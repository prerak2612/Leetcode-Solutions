class Solution:
    def numOfSubarrays(self, arr: List[int], k: int, threshold: int) -> int:
        count = 0
        currrent_avg = sum(arr[0:k])
        start = 0
        if currrent_avg // k >= threshold:
            count += 1

        for end in range(k,len(arr)):
            currrent_avg += arr[end]
            currrent_avg -= arr[start]
            start += 1
            if (currrent_avg // k) >= threshold:
                count += 1
        return count
            
            
        
