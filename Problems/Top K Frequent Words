import heapq
class Solution:
    def topKFrequent(self, words: List[str], k: int) -> List[str]:
        res = []
        dic = {}
        for i in words:
            if i in dic:
                dic[i] += 1
            else:
                dic[i] = 1
        for key,value in dic.items():
            res.append((-value,key))
        heapq.heapify(res)
        ans = []
        for _ in range(k):
            val,key = heapq.heappop(res)
            ans.append(key)
        return ans




        
