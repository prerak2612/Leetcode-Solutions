# Definition for singly-linked list.
# class ListNode:
#     def __init__(self, val=0, next=None):
#         self.val = val
#         self.next = next
class Solution:
    def pairSum(self, head: Optional[ListNode]) -> int:
        slow = head
        fast = head
        while fast and fast.next:
            fast = fast.next.next
            slow = slow.next
        curr = slow
        prev = None
        while curr:
            next_node = curr.next
            curr.next = prev
            prev = curr
            curr = next_node
        second_half = prev
        first_half = head
        summ = 0
        maxi = 0
        while first_half and second_half:
            summ = first_half.val + second_half.val
            maxi = max(summ,maxi)
            first_half = first_half.next
            second_half = second_half.next
        return maxi





